# GeoWatch environment. Copy to .env and fill in; .env is gitignored, this
# file is not. NEVER put a key's contents here: secrets are files or
# platform secrets (DEPLOY.md). Every variable the code reads is listed.

# ── required everywhere ─────────────────────────────────────────────────
# The API's shared secret. The API refuses to start without it. Server-side
# only in production: the browser never holds it (deploy/asgi.py adds it to
# the few public routes it forwards). Generate:
#   python -c 'import secrets; print(secrets.token_urlsafe(32))'
GEOWATCH_API_KEY=
# Google Cloud project registered for Earth Engine.
GEE_PROJECT_ID=

# ── deployment (deploy/runtime.py, deploy/asgi.py) ──────────────────────
# "production" makes missing GEOWATCH_CODE_COMMIT / service account fatal.
GEOWATCH_ENV=development
# Path to the Earth Engine service-account key FILE (mounted secret; Render:
# /etc/secrets/ee-key.json). Unset in development = your own
# `earthengine authenticate` credentials.
GEE_SERVICE_ACCOUNT_KEY_FILE=
# docker compose only: where the key file lives on the host (mounted read-only).
GEE_KEY_FILE_HOST=
# The results-determining commit; set from deploy/code_commit.sh at build.
# Outside git, analysis/contract.py reads it for every result's version.
GEOWATCH_CODE_COMMIT=
# Comma-separated browser origins allowed to call the API cross-origin.
# Empty when the site proxies /api on its own origin.
GEOWATCH_CORS_ORIGINS=
# 1 behind a proxy that sets X-Forwarded-For (Render, nginx in compose).
GEOWATCH_TRUST_PROXY=0
# 1 = anyone can start an analysis from the public explorer, within the caps.
GEOWATCH_PUBLIC_JOBS=1
# Rate limits, per client (hashed IP) unless stated.
GEOWATCH_RATE_READ_PER_MIN=240
GEOWATCH_RATE_POLL_PER_MIN=120
GEOWATCH_RATE_IMAGERY_PER_HOUR=60
GEOWATCH_RATE_ANALYSIS_PER_HOUR=4
GEOWATCH_RATE_KEYED_PER_MIN=600
# All clients together: new public analyses per day (Earth Engine budget).
GEOWATCH_ANALYSIS_PER_DAY=100
GEOWATCH_LOG_LEVEL=INFO
# Tests only: import deploy.asgi without building the app.
GEOWATCH_DEPLOY_NO_AUTOBUILD=0

# ── storage ─────────────────────────────────────────────────────────────
# Vector layer cache (Overpass + Open Buildings). Default ~/.cache/geowatch/vector;
# the image sets /app/data/cache/vector (on the persistent disk).
GEOWATCH_VECTOR_CACHE=

# ── worker (deploy/worker.py) ───────────────────────────────────────────
GEOWATCH_QUEUE_DIR=data/queue
GEOWATCH_WORKER_POLL_S=5
GEOWATCH_WORKER_TRACEBACKS=0

# ── frontend build (web/, read by Vite at build time) ───────────────────
# API origin. Empty = same origin (production: the static site proxies /api).
# Unset = http://127.0.0.1:8000 (local development).
VITE_API_BASE=
# DEVELOPMENT ONLY. Anything VITE_* is inlined into the public bundle, so
# never set this for a deployed build.
VITE_GEOWATCH_API_KEY=

# ── set by the platform, not by you ─────────────────────────────────────
# RENDER_GIT_COMMIT  (fallback for GEOWATCH_CODE_COMMIT on Render)
# PORT               (the port the API listens on; default 8000)
