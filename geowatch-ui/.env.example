# Copy to geowatch-ui/.env and set to the same value as GEOWATCH_API_KEY in the
# repo-root .env, which is what the backend reads.
#
# Vite INLINES VITE_* values into the built bundle, so anyone who loads the page
# can read this. That is a property of shipping a secret to a browser, not a bug
# here: it is a development shared secret for a localhost tool, not client
# authentication. See geowatch-ui/src/api.js for the full reasoning and what a
# deployed design would need instead.
VITE_GEOWATCH_API_KEY=
